enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FeederStatus {
  ENERGIZED
  DE_ENERGIZED
  FAULTED
}

enum AreaType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  CRITICAL_SERVICE
}

model Zone {
  id          String       @id @default(uuid(7))
  name        String       @unique
  code        String       @unique
  description String?
  managerId   String?
  manager     User?        @relation(fields: [managerId], references: [id], onDelete: SetNull)
  substations Substation[]
  staff       Profile[]
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([managerId])
  @@index([deletedAt])
  @@map("zones")
}

model Substation {
  id         String    @id @default(uuid(7))
  zoneId     String
  zone       Zone      @relation(fields: [zoneId], references: [id])
  name       String
  code       String    @unique
  capacityMw Float
  feeders    Feeder[]
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([zoneId])
  @@index([deletedAt])
  @@map("substations")
}

model Feeder {
  id               String            @id @default(uuid(7))
  substationId     String
  substation       Substation        @relation(fields: [substationId], references: [id])
  name             String
  code             String            @unique
  capacityMw       Float
  loadMw           Float             @default(0)
  priority         PriorityLevel     @default(MEDIUM)
  status           FeederStatus      @default(ENERGIZED)
  areas            Area[]
  scheduledOutages ScheduledOutage[]
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([substationId])
  @@index([priority, status])
  @@index([deletedAt])
  @@map("feeders")
}

model Area {
  id               String            @id @default(uuid(7))
  feederId         String
  feeder           Feeder            @relation(fields: [feederId], references: [id])
  name             String
  code             String            @unique
  type             AreaType          @default(RESIDENTIAL)
  customerCount    Int               @default(0)
  address          String?
  profiles         Profile[]
  scheduledOutages ScheduledOutage[]
  outages          Outage[]
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([feederId])
  @@index([deletedAt])
  @@map("areas")
}
