{
  "name": "Load Shedding & Power Outage Management System",
  "version": "1.0.0",
  "description": "Load Shedding & Power Outage Management System API",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "format:check": "npx biome format ./src",
    "format:fix": "npx biome format --write ./src",
    "lint:check": "npx biome lint ./src",
    "lint:fix": "npx biome lint --write ./src",
    "db:seed": "tsx seed/seed.ts"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "prisma": "^7.10.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.12",
    "cloudinary": "^2.11.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  }
}
